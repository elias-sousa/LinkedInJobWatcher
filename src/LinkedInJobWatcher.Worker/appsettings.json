{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/linkedin-job-watcher-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "LinkedIn": {
    "BrowserProfileDir": "./browser-profile",
    "Headless": true,
    "MaxItemsPerSearch": 30,
    "DatePosted": "past-24h",
    "DatePostedFallback": "past-week",
    "PostSearchTerms": [
      "vaga desenvolvedor .net senior remoto",
      "vaga c# senior home office",
      "hiring senior .net developer remote",
      "oportunidade backend .net senior"
    ],
    "JobSearchTerms": [
      ".NET Senior",
      "C# Senior",
      "Desenvolvedor Backend .NET"
    ],
    "JobTimePostedFilter": "r172800",
    "JobWorkplaceTypeFilter": "2",
    "JobExperienceLevelFilter": "4",
    "MinDelayMillisecondsBetweenActions": 1000,
    "MaxDelayMillisecondsBetweenActions": 4000
  },

  "Filters": {
    "MaxAgeDays": 2,
    "MinScore": 60,
    "Weights": {
      "DotNetFocus": 35,
      "Remote": 25,
      "Senior": 20,
      "StackItemEach": 2,
      "StackMax": 10,
      "Finance": 5,
      "DirectContact": 5,
      "OnSitePenalty": -30,
      "HybridOutsideRioPenalty": -30,
      "HybridInRioPenalty": -10,
      "JuniorLevelPenalty": -30,
      "NonDotNetFocusPenalty": -25
    },
    "DotNetKeywords": [ ".net", "dotnet", "asp.net", "c#", "csharp", ".net core", ".net framework", ".net 6", ".net 7", ".net 8", ".net 9" ],
    "JobIndicatorKeywords": [ "vaga", "vagas", "oportunidade", "oportunidades", "contratando", "hiring", "we're hiring", "were hiring", "procuramos", "buscamos", "envie seu currículo", "envie seu curriculo", "job", "position", "estamos contratando", "recrutamento" ],
    "RemoteKeywords": [ "remoto", "remota", "home office", "100% remoto", "full remote", "remote" ],
    "SeniorKeywords": [ "senior", "sênior", "sr.", "sr ", "especialista", "lead técnico", "lead tecnico", "tech lead" ],
    "StackKeywords": [ "sql server", "mongodb", "postgresql", "postgres", "azure", "aws", "microsserviços", "microservicos", "microservices", "service bus", "sqs", "mensageria", "entity framework", "ef core", "dapper" ],
    "FinanceKeywords": [ "banco", "bancos", "crédito", "credito", "pagamentos", "pagamento", "pix", "fintech", "seguros", "seguradora" ],
    "JuniorLevelKeywords": [ "júnior", "junior", "pleno", "estágio", "estagio", "trainee" ],
    "NonDotNetFocusKeywords": [ "front-end", "frontend", "front end", "mobile", "android", "ios", "java ", "python", "php" ],
    "OnSiteKeywords": [ "presencial obrigatório", "presencial obrigatorio", "100% presencial", "somente presencial" ],
    "HybridKeywords": [ "híbrido", "hibrido", "hybrid" ],
    "RioDeJaneiroKeywords": [ "rio de janeiro", " rj", "rj,", "rj.", "são gonçalo", "sao goncalo", "niterói", "niteroi" ]
  },

  "Schedule": {
    "IntervalMinutes": 20,
    "JitterMinutes": 5,
    "WindowStartHour": 7,
    "WindowEndHour": 22,
    "ActiveDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ],
    "MaxSearchesPerCycle": 2
  },

  "Email": {
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUsername": "seuemail@outlook.com",
    "SmtpPassword": "",
    "FromAddress": "seuemail@outlook.com",
    "FromName": "LinkedIn Job Watcher",
    "ToAddress": "seuemail@outlook.com",
    "SessionAlertCooldownHours": 12
  },

  "Storage": {
    "DatabasePath": "./data/linkedin-job-watcher.db",
    "RetentionDays": 60,
    "DuplicateCompanyTitleWindowDays": 7
  }
}
